[Unit]
Description=comidas: aviso al móvil de lo que hay que pasar al frigo para mañana
After=network-online.target mealie.service
Wants=mealie.service

[Service]
Type=oneshot
User=www-data
WorkingDirectory=/opt/comidas
EnvironmentFile=/opt/comidas/.env
StateDirectory=comidas
ExecStart=/opt/comidas/.venv/bin/python -m panel.avisos descongelar
