# Copia a .env y rellena. El .env real está gitignoreado y solo vive en el servidor.

# --- Mealie ---
MEALIE_URL=http://127.0.0.1:9000
# Token de API de Mealie (perfil → API Tokens). Las valoraciones se guardan a nombre de su usuario.
MEALIE_TOKEN=
# URL de Mealie que abre el navegador (enlaces y fotos de recetas). Vacío = MEALIE_URL.
MEALIE_PUBLIC_URL=https://mealie.example.com
MEALIE_GROUP_SLUG=home

# --- Home Assistant: lista de la compra y avisos ---
HA_URL=http://homeassistant.local:8123
# Token de larga duración (perfil de HA → Seguridad).
HA_TOKEN=
HA_TODO_ENTITY=todo.lista_de_la_compra
# Servicio notify de la app de HA del móvil (sin "notify."). Vacío = sin avisos.
HA_NOTIFY=
# Lo que abre tocar un aviso.
PANEL_URL=https://comidas.example.com

# --- Panel ---
ETIQUETA_CONGELABLE=congelable
TZ=Europe/Madrid
# Opcional: ruta de la base de datos del panel (por defecto /var/lib/comidas/comidas.db).
# COMIDAS_DB=
